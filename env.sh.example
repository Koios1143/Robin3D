# Copy to env.sh (gitignored) and fill in. Every extra_eval/*.sh sources it from the repo root.
# The ${VAR:-...} form lets a value given on the command line override this file.

# --- environment ---
export ROBIN3D_ENV="${ROBIN3D_ENV:-/path/to/robin3d-venv}"            # venv made by extra_eval/build_env_cu128.sh
export UV_CACHE_DIR="${UV_CACHE_DIR:-/path/to/cache/uv}"
export HF_HOME="${HF_HOME:-/path/to/cache/huggingface}"
# export TMPDIR=/path/to/tmp
# export JAVA_HOME=/path/to/jre; export PATH="$JAVA_HOME/bin:$PATH"   # pycocoevalcap needs Java

# --- data (extra_eval/download.sh fills ROBIN3D_DATA from the authors' Google Drive) ---
export ROBIN3D_DATA="${ROBIN3D_DATA:-/path/to/robin3d/drive}"
export LLAMA="${LLAMA:-lmsys/vicuna-7b-v1.5}"                          # HF id or local path
export REAL3DQA_DIR="${REAL3DQA_DIR:-/path/to/Real-3DQA}"             # <split>.jsonl from HF Oliver-Ma/Real-3DQA
# from HF ZzZZCHS/Chat-Scene annotations/ (Robin3D's scorers read them from the authors' disk)
export SCAN2CAP_CORPUS="${SCAN2CAP_CORPUS:-/path/to/scan2cap_val_corpus.json}"
export SCANREFER_LOOKUP="${SCANREFER_LOOKUP:-/path/to/scanrefer_unique_multiple_lookup.json}"
# export CKPT=/path/to/ckpt_01.pth        # default: $ROBIN3D_DATA/ckpt_for_robin3d_final_performance/ckpt_01.pth
# export NGPU=2
# export BATCH_SIZE=8
# export PREFIX_CACHE=1                 # faster evaluation, see README (GEN_BATCH=32)

# --- scoring (extra_eval/score.sh; Beacon3D QA GPT judge) ---
export OPENAI_API_KEY="${OPENAI_API_KEY:-sk-...}"

# --- Beacon3D 3RScan / MultiScan: feature rebuild (extra_eval/feats/run_prepare.sh, run_feats.sh) ---
# export FEATS_WORK=/path/to/robin3d/feats          # when set, run_extra_eval.sh also registers the rebuilt sets
# export FEATS_ENV=/path/to/feats-venv             # torch, timm 1.0, transformers, opencv, plyfile, scipy
# export MASK3D_ENV=/path/to/mask3d-venv           # MinkowskiEngine, hydra 1.0, pytorch-lightning 1.x, pointnet2
# export MASK3D_ROOT=/path/to/Mask3D               # clone of JonasSchult/Mask3D
# export MASK3D_CKPT=/path/to/scannet200_val.ckpt
# export MASK3D_META=/path/to/processed/scannet200 # label_database.yaml + color_mean_std.yaml
# export UNI3D_CKPT=/path/to/uni3d-g/model.pt      # HF BAAI/Uni3D modelzoo/uni3d-g
# export DINOV2=facebook/dinov2-giant
# export RSCAN_RAW=/path/to/3RScan                 # scans/<id>/{labels.instances.annotated.v2.ply,mesh.refined.0.010000.segs.v2.json,sequence.zip}
# export MSCAN_RAW=/path/to/MultiScan              # unzipped <scene>/<scene>.{ply,json,jsonl,mp4,depth.zlib}
# export RSCAN_SCAN_DATA=/path/to/SceneVerse/3RScan
